{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://jphic-kit-api.onrender.com/:path*" },
    { "source": "/core", "destination": "/core/index.html" },
    { "source": "/logo", "destination": "/logo/index.html" },
    { "source": "/pdf", "destination": "/pdf/index.html" },
    { "source": "/motion", "destination": "/motion/index.html" },
    { "source": "/agency", "destination": "/agency/index.html" },
    { "source": "/event", "destination": "/event/index.html" },
    { "source": "/kit", "destination": "/kit/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
